# Server Configuration
PORT=8000
HOST=0.0.0.0

# Groq API Configuration
GROQ_API_KEY=

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Basic_RAG

# Vector Storage & Embeddings Configuration (Uses local CPU embeddings)
DEFAULT_EMBEDDING_PROVIDER=huggingface
# Optional sentence-transformers model (default: all-MiniLM-L6-v2)
HF_EMBEDDING_MODEL=all-MiniLM-L6-v2

